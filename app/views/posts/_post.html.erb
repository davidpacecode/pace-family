<div id="<%= dom_id post %>">
  <div>
    <strong>User:</strong>
    <%= post.user_id %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= post.category_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Excerpt:</strong>
    <%= post.excerpt %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= post.body %>
  </div>

  <div>
    <strong>Attachments:</strong>
    <% post.attachments.each do |attachment| %>
      <div><%= link_to attachment.filename, attachment %></div>
    <% end %>
  </div>

</div>
