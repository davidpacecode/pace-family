<div class="wa-split">
  <%= link_to root_path, style: "text-decoration: none; color: black;" do %>
    <div class="wa-cluster wa-gap-2xs">
      <wa-icon name="star" style="color: red"></wa-icon>
      <h4>Pace Family</h4>
    </div>
  <% end %>
  <div class="wa-cluster">
    <%= link_to "Posts", posts_path, class: ["nav-link wa-font-weight-bold", { active: controller_name == "posts" }] %>
    <%= link_to "Marwan", marwan_path, class: ["nav-link wa-font-weight-bold", { active: current_page?(marwan_path) }] %>
    <%= link_to "About", about_path, class: ["nav-link wa-font-weight-bold", { active: current_page?(about_path) }] %>
  </div>
</div>
