
<%= link_to root_path, class: "brand wa-cluster wa-gap-xs" do %>
  <wa-icon class="brand-mark" name="house-chimney-heart" family="duotone" variant="solid"></wa-icon>
  <span class="brand-name">Pace Family</span>
<% end %>

<nav class="header-nav wa-cluster wa-gap-l" aria-label="Main">
  <%= link_to "About", about_path %>
  <%= link_to "Marwanbot", marwanbot_path %>
  <%= link_to "Login", new_session_path unless authenticated? %>
  <%= button_to "Log out", session_path, method: :delete if authenticated? %>
</nav>

<wa-button data-toggle-nav appearance="plain" class="wa-mobile-only" aria-label="Open menu">
  <wa-icon name="bars"></wa-icon>
</wa-button>


