<%= link_to root_path, class: "wa-link-plain" do %>
  <div class="wa-cluster">
    <wa-icon name="house-chimney-heart" family="sharp-duotone" variant="light" style="font-size: 2em;  --primary-color: rgb(116, 192, 252); --secondary-color: rgb(116, 192, 252);"></wa-icon>
    <span class="wa-font-size-2xl wa-font-weight-bold">Pace Family</span>
  </div>
  <div class="wa-cluster">
    <%= link_to "About", about_path, class: "wa-link-plain wa-font-size-xl wa-font-weight-bold" %>
    <%= link_to "Login", new_session_path, class: "wa-link-plain wa-font-size-xl wa-font-weight-bold" unless authenticated? %>
    <%= button_to "Log out", session_path, method: :delete if authenticated? %>
  </div>
<% end %>
