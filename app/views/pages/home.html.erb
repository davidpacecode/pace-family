<!-- Hero -->
<section class="section">
  <div class="container wa-stack wa-gap-l prose">
    <p class="eyebrow">Welcome to pace.family</p>
    <h1 class="headline">A cozy little corner of the internet for <span class="highlight">the Paces</span>.</h1>
    <p class="lede">
      Updates, 40+ year old running jokes, Karate Kid, and Marwan.
    </p>
  </div>
</section>

<!-- Latest posts (sample content) -->
<section class="section" id="latest">
  <div class="container wa-stack wa-gap-l">
    <div class="wa-split wa-align-items-end">
      <h2>Latest...</h2>
      <a href="#">All posts <wa-icon name="arrow-right"></wa-icon></a>
    </div>

    <ul class="post-list">
      <% @posts.each do |post| %>
        <li class="post-row wa-stack wa-gap-xs">
          <div class="wa-cluster wa-gap-xs post-meta">
            <wa-tag size="s" pill variant="brand">Everyone</wa-tag>
            <span><%= post.created_at.strftime("%B %-d") %></span>
          </div>
          <h3><a href="#">Welcome to pace.family</a></h3>
          <p>Why we built a little home on the web, and what you'll find here.</p>
        </li>

        <li class="post-row wa-stack wa-gap-xs">
          <div class="wa-cluster wa-gap-xs post-meta">
            <wa-tag size="s" pill>
              <wa-icon name="lock" variant="solid"></wa-icon>
              Brothers &amp; Mom
            </wa-tag>
            <span>October 9</span>
          </div>
          <h3><a href="#">Sample family post title</a></h3>
          <p>Log in to read posts shared with this circle.</p>
        </li>

        <li class="post-row wa-stack wa-gap-xs">
          <div class="wa-cluster wa-gap-xs post-meta">
            <wa-tag size="s" pill>
              <wa-icon name="lock" variant="solid"></wa-icon>
              Austin Paces
            </wa-tag>
            <span>October 3</span>
          </div>
          <h3><a href="#">Sample home post title</a></h3>
          <p>Log in to read posts shared with this circle.</p>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<!-- Fun stuff -->
<section class="section tinted">
  <div class="container">
    <wa-card>
      <div class="wa-flank wa-gap-l">
        <span class="circle-icon"><wa-icon name="robot" family="duotone" variant="solid"></wa-icon></span>
        <div class="wa-split wa-gap-m">
          <div class="wa-stack wa-gap-2xs">
            <p class="eyebrow">Fun stuff</p>
            <h2 class="wa-heading-m">Meet Marwanbot</h2>
            <p class="wa-color-text-quiet">An AI with a whole lot of personality. Coming soon.</p>
          </div>
          <wa-button variant="brand" pill href="marwanbot.html">
            Say hello
            <wa-icon slot="end" name="arrow-right"></wa-icon>
          </wa-button>
        </div>
      </div>
    </wa-card>
  </div>
</section>
