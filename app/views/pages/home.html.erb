<!-- Hero -->
<section class="section">
  <div class="container wa-stack wa-gap-l prose">
    <p class="eyebrow">Welcome to pace.family</p>
    <h1 class="headline">A cozy little corner of the internet for <span class="highlight">the Paces</span>.</h1>
    <p class="lede">
      Stories, photos, and updates shared with just the right people. Some posts are for everyone.
      Most are just for family.
    </p>
    <div class="wa-cluster wa-gap-s">
      <wa-button variant="brand" size="l" pill href="#latest">
        Read the latest
        <wa-icon slot="end" name="arrow-down"></wa-icon>
      </wa-button>
      <wa-button appearance="outlined" size="l" pill href="about.html">What is this?</wa-button>
    </div>
  </div>
</section>

