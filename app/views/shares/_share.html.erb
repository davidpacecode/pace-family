<div id="<%= dom_id share %>">
  <div>
    <strong>Title:</strong>
    <%= share.title %>
  </div>

  <div>
    <strong>Headline:</strong>
    <%= share.headline %>
  </div>

  <div>
    <strong>Tags:</strong>
    <%= share.tags %>
