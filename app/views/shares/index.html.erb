<p style="color: green"><%= notice %></p>

<% content_for :title, "Shares" %>

<h3><%= @shares.select(:audience).distinct.first.audience.humanize %> Shares</h3>


<div id="shares">
  <% @shares.each do |share| %>
    <%= render share %>
    <p>
      <%= link_to "Show this share", share %>
    </p>
  <% end %>
</div>

<%= link_to "New share", new_share_path %>
